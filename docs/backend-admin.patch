+                    [col.name for col in c.columns],
+                    [element.target_fullname for element in c.elements],
+                    name=c.name,
+                )
+                for c in list(table.constraints)
+                if isinstance(c, sa.ForeignKeyConstraint)
+            ],
+            comment=table.comment,
+            **dict(table.kwargs),
+        )
