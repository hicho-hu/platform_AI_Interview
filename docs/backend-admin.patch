+        require(row.status in ("ACTIVE", "FROZEN"), "USER_INVALID_STATE", "账号不可变更", 409)
+        row.status = data.status
+        self.audit("USER_" + data.status, uid, data.reason)
+        return {"id": uid, "status": row.status}
